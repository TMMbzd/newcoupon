<?xml version="1.0" encoding="UTF-8"?>
<!--
  优惠券中台 · 阶段0单体工程

  规范说明（对标大厂实践）：
  1. 依赖版本统一由 spring-boot-starter-parent BOM 管理，禁止在业务 pom 里散落三方版本号（依赖治理）；
  2. 只引入阶段0必需的依赖——MySQL/Flyway/MyBatis-Plus。Redis/MQ/分库分表在对应阶段再进场，
     "依赖在痛点出现时引入"（阿里规约：禁止超前设计）；
  3. 打开 -Werror 级别的编译告警是阶段1再做的事，先保持零门槛。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.newcoupon</groupId>
  <artifactId>newcoupon-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>newcoupon-server</name>
  <description>优惠券系统中台 · 阶段0单体（创/发/用/计 最小闭环）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
  </properties>

  <dependencies>
    <!-- Web + 参数校验：JSR-303 是接口契约的第一道防线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 健康检查探针：本地是 actuator/health，未来上 K8s 就是 liveness/readiness probe -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ORM：MyBatis-Plus（阶段2 分库分表时在底层叠加 ShardingSphere-JDBC） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- SQL 版本化管理：所有建表/变更必须走 Flyway 迁移脚本，禁止手工改库（大厂 DBA 红线） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：阶段1库存闸门（Lua 五重校验）。默认连 localhost:6379（docker compose 已含） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 测试：单测必须秒级、相互独立、不依赖 Spring 容器与真实中间件（大厂单测基线） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试：Testcontainers 在测试启动时拉起一次性真实 MySQL 容器。
         为什么不用 H2 内存库：方言差异会让"唯一索引行为/事务隔离"测不准——
         并发正确性必须在真 MySQL 上验证；为什么不用常驻 dev 库：测试要可重复、无残留。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
          <!-- XXL-JOB 执行器（ADR-0010 调度平台终局选型；条件装配，tests 默认关闭） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>2.4.1</version>
        </dependency>
</dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
