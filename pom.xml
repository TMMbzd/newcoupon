<?xml version="1.0" encoding="UTF-8"?>
<!--
  优惠券中台 · 阶段0单体工程

  规范说明（对标大厂实践）：
  1. 依赖版本统一由 spring-boot-starter-parent BOM 管理，禁止在业务 pom 里散落三方版本号（依赖治理）；
  2. 只引入阶段0必需的依赖——MySQL/Flyway/MyBatis-Plus。Redis/MQ/分库分表在对应阶段再进场，
     "依赖在痛点出现时引入"（阿里规约：禁止超前设计）；
  3. 打开 -Werror 级别的编译告警是阶段1再做的事，先保持零门槛。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.newcoupon</groupId>
  <artifactId>newcoupon-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>newcoupon-server</name>
  <description>优惠券系统中台 · 阶段0单体（创/发/用/计 最小闭环）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <!-- Boot BOM 未纳管，显式声明（见下方依赖注释） -->
    <resilience4j.version>2.2.0</resilience4j.version>
    <!-- 限流库版本（见下方依赖处的选型理由） -->
    <bucket4j.version>8.21.0</bucket4j.version>
    <!-- Sentine 版本：1.8.10 是当前最新 GA（2.0.0-alpha 自 2023 起未 GA） -->
    <sentinel.version>1.8.10</sentinel.version>
  </properties>

  <dependencies>
    <!-- Web + 参数校验：JSR-303 是接口契约的第一道防线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- S2 第 7 步：调用熔断（依赖不可用时快速失败，而不是每个请求都等超时）。
         只用核心的 circuitbreaker 模块——采用编程式（在具体调用点包一层），不用注解式，
         因为熔断要加在基础设施调用上，而不是 Controller 方法上。版本由 Boot BOM 管理。 -->
    <!-- 版本说明（例外）：Boot 3.3.5 的依赖清单里**没有**纳管 Resilience4j，所以这里必须显式声明。
         按项目的依赖治理约定，散落的三方版本号要避免，但"BOM 没管"是唯一合理的例外——
         写清版本来源（Maven Central 的 2.2.0，与 Boot 3.x 适配）与升级触发条件（随 Boot 升级时复核）。 -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <!-- 健康检查探针：本地是 actuator/health，未来上 K8s 就是 liveness/readiness probe -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 2e-⑤ 最小可观测：Prometheus 指标端点（/actuator/prometheus） -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 限流：Bucket4j（2026-10-08 替换自研的三个算法实现）。
         选它的理由（见 docs/限流选型-业界调研-2026-10-08.md）：
         ① 契约正确——getProxy(key, config) 的 key 就是"限谁"，不含时间信息；
            自研接口当年把"键必须自带窗口标识"写进了契约，导致滑动窗口读不到上一窗口；
         ② 可**复用项目现有的 Lettuce 连接**，不引入第二个 Redis 客户端栈（这是排除 Redisson 的主因）；
         ③ Apache-2.0，且持续发版（8.21.0 是 2026-10-02 发布）；
         ④ 零新传递依赖。
         制品按 JDK 分档：必须用 jdk17 坐标；网上老教程常引用的
         com.bucket4j:bucket4j-redis（Jedis 版）与 bucket4j_jdk17-redis 都已停更。 -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-lettuce</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <!-- 限流：Sentinel（2026-10-08 决定全面迁移过来，见 docs/S3-限流全面迁移到Sentinel-需求与设计-2026-10-08.md）。
         坐标核实（无需排除项）：
         · 传递依赖里的 fastjson 是 **test scope**，不进生产依赖；
         · jakarta.servlet-api / spring-webmvc 都是 **provided**，不会与 Boot 3.3.5 冲突；
         · 官方**没有** sentinel-spring-boot-starter（Central 上那个是 2018 年的 0.1.0），
           也没有自动配置——必须手动 addInterceptor。 -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-spring-webmvc-v6x-adapter</artifactId>
      <version>${sentinel.version}</version>
    </dependency>
    <!-- 动态规则源的基础设施（AutoRefreshDataSource / Converter）。
         适配器不含它，但官方明确要求集群流控"必须对接动态规则源"，所以这一层是必需的。 -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-datasource-extension</artifactId>
      <version>${sentinel.version}</version>
    </dependency>

    <!-- S2 第 11 步（RQ-10）：把熔断状态接进 Micrometer。
         为什么用官方集成而不是自建 Gauge：它会**自动跟进**熔断器的懒创建、按租户动态创建与移除
         （实测：绑定之后新建的熔断器也会被补上指标，evict 之后序列真实消失）——
         自建 Gauge 要把这套生命周期再实现一遍，且极易漏掉"后创建的熔断器"。
         排除 4 个用不到的模块：它们在本 artifact 里是 runtime 依赖，而本项目只用了 circuitbreaker
         （留着的代价是依赖树噪音与潜在的版本冲突面）。 -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <version>${resilience4j.version}</version>
      <exclusions>
        <exclusion>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-bulkhead</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-retry</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-ratelimiter</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.github.resilience4j</groupId>
          <artifactId>resilience4j-timelimiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- ORM：MyBatis-Plus（阶段2 分库分表时在底层叠加 ShardingSphere-JDBC） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- SQL 版本化管理：所有建表/变更必须走 Flyway 迁移脚本，禁止手工改库（大厂 DBA 红线） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：阶段1库存闸门（Lua 五重校验）。默认连 localhost:6379（docker compose 已含） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- P2c 模板本地缓存（Caffeine：refreshAfterWrite 防击穿/负缓存短TTL 防穿透/TTL抖动 防雪崩） -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- P2d 阶段二：RocketMQ 客户端（裸客户端而非 spring-boot-starter——Boot3 兼容版本混乱，
         手写装配可见性也更好。版本需显式：rocketmq-client 不在 Boot BOM 里） -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>5.1.4</version>
    </dependency>

    <!-- 测试：单测必须秒级、相互独立、不依赖 Spring 容器与真实中间件（大厂单测基线） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试：Testcontainers 在测试启动时拉起一次性真实 MySQL 容器。
         为什么不用 H2 内存库：方言差异会让"唯一索引行为/事务隔离"测不准——
         并发正确性必须在真 MySQL 上验证；为什么不用常驻 dev 库：测试要可重复、无残留。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
          <!-- ShardingSphere JDBC（ADR-0010 批次二：user_id%64 分表路由先行，驱动模式兼容 Boot3） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.0</version>
            <exclusions>
                <!-- 5.5.0 发布缺陷：传递依赖了未发布的 test-util（Central 亦 404，5.5.x 全系如此），
                     运行时用不到，排除后可用（实测验证） -->
                <exclusion>
                    <groupId>org.apache.shardingsphere</groupId>
                    <artifactId>shardingsphere-test-util</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- JAXB 运行时（javax 命名空间版）：JDK11+ 移除内置 JAXB；ShardingSphere 5.4 用的是
             旧 javax API，glassfish 4.x 是 jakarta 实现不兼容（实测踩坑），必须 2.3.x -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.9</version>
        </dependency>
        <!-- XXL-JOB 执行器（ADR-0010 调度平台终局选型；条件装配，tests 默认关闭） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>2.4.1</version>
        </dependency>
</dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
