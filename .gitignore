# ---- 构建 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# 控制台前端依赖（node_modules 绝不入 git；构建产物 static/console/ 入 git——克隆即跑）
console/node_modules/
# Playwright 运行产物（失败截图/trace 等，跑完即弃；取证截图另存 docs/evidence/）
console/test-results/
console/playwright-report/

# ---- IDE ----
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# ---- 运行时 ----
logs/
*.log
heapdump.*
hs_err_pid*

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 本地私有配置（不进仓库，含密码等敏感信息）----
application-local.yml
# docker compose 的环境变量默认文件（5C 刀 B 起 observe profile 的凭据可能写进它）
.env

# ---- 意外产物防护 ----
# Windows 侧工具（如 VSCode Java 扩展）以 Windows 路径在 WSL 项目内跑 Maven 时，
# 会生成字面名为 C: 的目录（C:\xxx 被当作相对路径）——拦截之
/C:/

# Claude Code 个人本地配置（权限等，不共享）
.claude/settings.local.json

# ---- 学习资料（讲解/教学文档，永不进入 git 与远端）----
study/
