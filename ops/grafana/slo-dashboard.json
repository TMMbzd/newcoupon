      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "coupon:sli_error_budget_remaining:ratio",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ],
      "title": "错误预算剩余（28d 窗）",
