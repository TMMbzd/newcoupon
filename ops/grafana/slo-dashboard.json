        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (journey, outcome) (rate(coupon_sli_events_total[5m]))",
          "legendFormat": "{{journey}}/{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "SLI 事件速率（按 journey / outcome）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "抓取目标存活（up==0 = 实例没了或抓取失败，含 Basic 凭据配错）。SLI 断流告警（CouponSliStreamMissing，absent_over_time 10m）是它的业务面补集：up 正常但序列消失=埋点回归。两块一起构成「可见性本身可见」。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "断流（DOWN / 抓取失败）"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
