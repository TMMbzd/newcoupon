    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "燃烧率 = 当前错误率 / 允许错误率，>1 即在烧预算。三条横线：14.4×（1h 快烧 page 阈）、6×（6h 慢烧 ticket 阈）、1×（预算消耗线）。告警在 ops/prometheus/slo-alerts.rules.yml，本面板是人的观察面。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "倍（×允许错误率）",
            "axisPlacement": "auto",
